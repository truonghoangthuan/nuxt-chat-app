# Nuxt Supabase module client configuration
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Optional: Google Cloud YouTube Data API v3 key (defaults to keyless InnerTube search)
YOUTUBE_API_KEY=

# Required for online Chess only. Server-side secret; never prefix with NUXT_PUBLIC_.
NUXT_SUPABASE_SECRET_KEY=
